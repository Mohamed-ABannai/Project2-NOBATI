<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Department | NOBATI</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/department.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

<%- include('../partials/navbar') %>

<main class="department-form-container">

    <div class="department-form-header">
        <p>DEPARTMENT MANAGEMENT</p>
        <h1>Update Department</h1>
        <span>Update the department information below.</span>
    </div>

    <div class="department-form-card">

        <div class="department-form-icon">
            <i class="bi bi-building-gear"></i>
        </div>

        <form action="/departments/<%= oneDep._id %>?_method=PUT" method="post">

            <div class="form-group">
                <label for="name">Department Name</label>
                <input value="<%= oneDep.name %>" id="name" name="name" type="text" required>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <input value="<%= oneDep.description %>" id="description" name="description" type="text" required>
            </div>

            <div class="department-form-actions">
                <a href="/departments">Cancel</a>

                <button type="submit">
                    <i class="bi bi-check-lg"></i>
                    Update Department
                </button>
            </div>

        </form>

    </div>

</main>

</body>
</html>