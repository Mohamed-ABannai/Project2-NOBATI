<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Department</title>
</head>
<body>

    <h1>Update Department</h1>

<form action="/departments/<%= oneDep._id %>?_method=PUT" method="post">

<label for="name">name</label>
