<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Department</title>
</head>
<body>
    
<h1>NOBATI Departments</h1>


<%for(let dep of allDep){ %>

<p>name: <%= dep.name %></p>
<p>description: <%= dep.description %></p>

<form action="/departments/<%= dep._id %>?_method=DELETE" method="post">
<button type="submit">Delete</button>
</form>
<a href="/departments/<%= dep._id %>/edit">edit</a>

<% }%>

</body>
</html>