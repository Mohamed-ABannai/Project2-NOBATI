<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Department | NOBATI</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/department.css">
</head>

<body>

<%- include('../partials/navbar') %>

<main class="department-form-container">

    <div class="department-form-header">
        <p>DEPARTMENT MANAGEMENT</p>
        <h1>Add New Department</h1>
        <span>Create a new medical department for NOBATI.</span>
    </div>

    <div class="department-form-card">

        <div class="department-form-icon">
            <i class="bi bi-building-add"></i>
        </div>

        <form action="/departments/create" method="post">

            <div class="form-group">
                <label for="name">Department Name</label>
                <input id="name" name="name" type="text" placeholder="Enter department name" required>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea name="description" id="description" placeholder="Enter department description" required></textarea>
            </div>

            <div class="department-form-actions">

                <a href="/departments">Cancel</a>

                <button type="submit">
                    <i class="bi bi-plus-lg"></i>
                    Add Department
                </button>

            </div>

        </form>

    </div>

</main>

</body>

</html>