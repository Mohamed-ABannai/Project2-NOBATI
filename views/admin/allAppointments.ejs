<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>All Appointments | NOBATI</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

<%- include('../partials/navbar.ejs') %>

<main class="admin-appointments">

    <div class="admin-appointments-header">

        <p>APPOINTMENT MANAGEMENT</p>

        <h1>All Appointments</h1>

        <span>View and manage patient appointments.</span>

    </div>

    <% if(appointments.length === 0){ %>

        <div class="no-admin-appointments">

            <i class="bi bi-calendar-x"></i>

            <h2>No Appointments Found</h2>

            <p>There are currently no appointments.</p>

        </div>

    <% } else { %>

        <div class="admin-appointments-table-container">

            <table class="admin-appointments-table">

                <thead>

                    <tr>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    <% for(let appointment of appointments){ %>

                        <tr>

                            <td>

                                <div class="appointment-patient">

                                    <i class="bi bi-person-circle"></i>

                                    <%= appointment.patient.username %>

                                </div>

                            </td>

                            <td>
                                <%= appointment.doctor.specialization %>
                            </td>

                            <td>
                                <%= appointment.appointmentDate.toLocaleDateString() %>
                            </td>

                            <td>
                                <%= appointment.appointmentTime %>
                            </td>

                            <td>
                                <%= appointment.reason %>
                            </td>

                            <td>

                                <span class="admin-appointment-status">
                                    <%= appointment.status %>
                                </span>

                            </td>

                            <td>

                                <div class="appointment-admin-actions">

                                    <% if(appointment.status !== "cancelled" && appointment.status !== "completed"){ %>

                                        <a href="/admin/appointments/<%= appointment._id %>/edit">

                                            <i class="bi bi-pencil"></i>

                                            Edit

                                        </a>

                                        <form action="/admin/appointments/<%= appointment._id %>/cancel?_method=PUT" method="post">

                                            <button type="submit">

                                                <i class="bi bi-x-lg"></i>

                                                Cancel

                                            </button>

                                        </form>

                                    <% } %>

                                </div>

                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    <% } %>

</main>

</body>

</html>