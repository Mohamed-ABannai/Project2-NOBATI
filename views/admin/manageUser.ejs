<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Manage Patients | NOBATI</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

<%- include('../partials/navbar.ejs') %>

<main class="manage-users">

    <div class="manage-users-header">
        <p>USER MANAGEMENT</p>
        <h1>Manage Patients</h1>
        <span>View and manage registered patients.</span>
    </div>

    <% if(allUsers.length === 0){ %>

        <div class="no-users">

            <i class="bi bi-people"></i>

            <h2>No Patients Found</h2>

            <p>There are currently no registered patients.</p>

        </div>

    <% } else { %>

        <div class="users-table-container">

            <table class="users-table">

                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    <% for(let user of allUsers){ %>

                        <tr>

                            <td>
                                <div class="patient-name">
                                    <i class="bi bi-person-circle"></i>
                                    <%= user.username %>
                                </div>
                            </td>

                            <td>
                                <%= user.email %>
                            </td>

                            <td>
                                <%= user.phone %>
                            </td>

                            <td>
                                <span class="patient-role">
                                    <%= user.role %>
                                </span>
                            </td>

                            <td>

                                <% if(user.isActive){ %>

                                    <span class="status-active">
                                        Active
                                    </span>

                                <% } else { %>

                                    <span class="status-inactive">
                                        Inactive
                                    </span>

                                <% } %>

                            </td>

                            <td>

                                <div class="user-actions">

                                    <a href="/admin/AllUser/<%= user._id %>/edit">
                                        <i class="bi bi-pencil"></i>
                                        Edit
                                    </a>

                                    <form action="/admin/AllUser/<%= user._id %>?_method=DELETE" method="post">

                                        <button type="submit">
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    <% } %>

</main>

</body>
</html>