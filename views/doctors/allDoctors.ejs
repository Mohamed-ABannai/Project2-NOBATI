<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Doctors | NOBATI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/doctors.css">
</head>
<body>

<%- include('../partials/navbar') %>

<main class="doctors-container">

<div class="doctors-header">
    <p class="doctors-label">MEDICAL TEAM</p>
    <h1>Our Doctors</h1>
    <p>Find the right doctor for your appointment.</p>
</div>

<div class="doctors-grid">

<% for(let doctor of doctors){ %>

<div class="doctor-card">

    <% if(doctor.image && doctor.image.data){ %>
        <img class="doctor-image" src="data:<%= doctor.image.contentType %>;base64,<%= doctor.image.data.toString('base64') %>" alt="<%= doctor.user.username %>">
    <% } else { %>
        <div class="doctor-avatar">
            <i class="bi bi-person-fill"></i>
        </div>
    <% } %>

    <div class="doctor-info">

        <span class="department-name"><%= doctor.department.name %></span>

        <h2>Dr. <%= doctor.user.username %></h2>

        <p class="specialization">
            <i class="bi bi-heart-pulse"></i>
            <%= doctor.specialization %>
        </p>

        <div class="doctor-details">
            <p><i class="bi bi-envelope"></i> <%= doctor.user.email %></p>

            <% if(doctor.user.phone){ %>
                <p><i class="bi bi-telephone"></i> <%= doctor.user.phone %></p>
            <% } %>

            <p><i class="bi bi-cash"></i> <%= doctor.consultationFee %> BHD</p>
        </div>

        <% if(doctor.bio){ %>
            <p class="doctor-bio"><%= doctor.bio %></p>
        <% } %>

        <% if(user && user.role === "admin"){ %>
        <div class="doctor-actions">
            <a href="/doctor/<%= doctor._id %>/edit">
                <i class="bi bi-pencil"></i> Edit
            </a>

            <form action="/doctor/<%= doctor._id %>?_method=DELETE" method="post">
                <button type="submit">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </form>
        </div>
        <% } %>

    </div>

</div>

<% } %>

</div>

</main>

</body>
</html>