<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirect Appointment | NOBATI</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/doctors.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

<%- include('../partials/navbar') %>

<main class="doctor-redirect-container">

    <div class="doctor-appointments-header">
        <p>APPOINTMENT MANAGEMENT</p>
        <h1>Redirect Appointment</h1>
        <span>Choose another doctor and set the new appointment date and time.</span>
    </div>

    <div class="doctor-redirect-card">

        <div class="doctor-redirect-patient">
            <i class="bi bi-person-circle"></i>

            <div>
                <span>PATIENT</span>
                <h2><%= appointment.patient.username %></h2>
            </div>
        </div>

        <% if(doctors.length === 0){ %>

            <p class="doctor-redirect-empty">
                There are no other active doctors available.
            </p>

        <% } else { %>

            <form action="/doctor/appointments/<%= appointment._id %>/redirect?_method=PUT" method="post" class="doctor-redirect-form">

                <div class="form-group">

                    <label for="doctor">New Doctor</label>

                    <select name="doctor" id="doctor" required>

                        <option value="" disabled selected>
                            Select a doctor
                        </option>

                        <% for(let doctor of doctors){ %>

                            <option value="<%= doctor._id %>">
                                Dr. <%= doctor.user.username %> -
                                <%= doctor.specialization %>
                                (<%= doctor.department.name %>)
                            </option>

                        <% } %>

                    </select>

                </div>


                <div class="form-group">

                    <label for="appointmentDate">New Date</label>

                    <input
                        type="date"
                        name="appointmentDate"
                        id="appointmentDate"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="appointmentTime">New Time</label>

                    <input
                        type="time"
                        name="appointmentTime"
                        id="appointmentTime"
                        required
                    >

                </div>


                <div class="doctor-redirect-actions">

                    <a href="/doctor/appointments">
                        Cancel
                    </a>

                    <button type="submit">
                        <i class="bi bi-arrow-right-circle"></i>
                        Redirect Appointment
                    </button>

                </div>

            </form>

        <% } %>

    </div>

</main>


<script>

    const today = new Date().toISOString().split('T')[0]

    document.getElementById('appointmentDate').min = today

</script>

</body>
</html>