<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Doctor Appointments | NOBATI</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/doctors.css">
</head>

<body>

<%- include('../partials/navbar') %>

<main class="doctor-appointments-container">

    <div class="doctor-appointments-header">

        <p>APPOINTMENT MANAGEMENT</p>

        <h1>My Appointments</h1>

        <span>View and manage your patient appointments.</span>

    </div>

    <% if(appointments.length === 0){ %>

        <div class="no-doctor-appointments">

            <i class="bi bi-calendar-x"></i>

            <h2>No Appointments</h2>

            <p>You don't have any patient appointments yet.</p>

        </div>

    <% } else { %>

        <div class="doctor-appointments-grid">

            <% for(let appointment of appointments){ %>

                <div class="doctor-appointment-card">

                    <div class="doctor-appointment-top">

                        <div class="patient-info">

                            <i class="bi bi-person-circle"></i>

                            <div>
                                <span>PATIENT</span>
                                <h2><%= appointment.patient ? appointment.patient.username : 'Unknown patient' %></h2>
                            </div>

                        </div>

                        <span class="doctor-appointment-status">
                            <%= appointment.status %>
                        </span>

                    </div>

                    <div class="doctor-appointment-details">

                        <p>
                            <i class="bi bi-calendar3"></i>
                            <strong>Date:</strong>
                            <%= appointment.appointmentDate ? appointment.appointmentDate.toLocaleDateString() : 'Not set' %>
                        </p>

                        <p>
                            <i class="bi bi-clock"></i>
                            <strong>Time:</strong>
                            <%= appointment.appointmentTime %>
                        </p>

                        <% if(appointment.patient && appointment.patient.phone){ %>

                            <p>
                                <i class="bi bi-telephone"></i>
                                <strong>Phone:</strong>
                                <%= appointment.patient.phone %>
                            </p>

                        <% } %>

                        <% if(appointment.reason){ %>

                            <p>
                                <i class="bi bi-chat-left-text"></i>
                                <strong>Reason:</strong>
                                <%= appointment.reason %>
                            </p>

                        <% } %>

                    </div>




                    <% if(appointment.status === "pending"){ %>

                        <div class="doctor-appointment-actions">

                            <form action="/doctor/appointments/<%= appointment._id %>/confirm?_method=PUT" method="post">

                                <button type="submit" class="confirm-btn">
                                    <i class="bi bi-check-lg"></i>
                                    Confirm
                                </button>

                            </form>

                            <form action="/doctor/appointments/<%= appointment._id %>/cancel?_method=PUT" method="post">

                                <button type="submit" class="cancel-btn">
                                    <i class="bi bi-x-lg"></i>
                                    Cancel
                                </button>

                            </form>

                        </div>

                    <% } %>




                    <% if(appointment.status === "confirmed"){ %>

                        <div class="doctor-appointment-actions">

                            <form action="/doctor/appointments/<%= appointment._id %>/complete?_method=PUT" method="post">

                                <button type="submit" class="complete-btn">
                                    <i class="bi bi-check-circle"></i>
                                    Complete
                                </button>

                            </form>

                        </div>

                    <% } %>

                    <% if(appointment.status === "completed"){ %>

                        <div class="doctor-appointment-actions">

                            <a href="/doctor/appointments/<%= appointment._id %>/redirect" class="redirect-btn">
                                <i class="bi bi-arrow-right-circle"></i>
                                Redirect to another doctor
                            </a>

                        </div>

                    <% } %>

                </div>

            <% } %>

        </div>

    <% } %>

</main>

</body>
</html>
