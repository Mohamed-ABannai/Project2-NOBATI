<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Appointments | NOBATI</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/appointment.css">
</head>
<body>

<%- include('../partials/navbar') %>

<main class="appointments-container">

    <div class="appointments-header">

        <div>
            <p>MY HEALTH</p>
            <h1>My Appointments</h1>
            <span>View and manage your appointments with NOBATI.</span>
        </div>

        <a href="/appointment/new" class="book-appointment-btn">
            <i class="bi bi-plus-lg"></i>
            Book Appointment
        </a>

    </div>

    <% if(appointments.length === 0){ %>

        <div class="no-appointments">

            <i class="bi bi-calendar2-x"></i>

            <h2>No Appointments Yet</h2>

            <p>You don't have any appointments yet.</p>

            <a href="/appointment/new" class="book-appointment-btn">
                Book Your First Appointment
            </a>

        </div>

    <% } else { %>

        <div class="appointments-grid">

            <% for(let appointment of appointments){ %>

                <div class="appointment-card">

                    <div class="appointment-card-header">

                        <div class="appointment-icon">
                            <i class="bi bi-calendar2-check"></i>
                        </div>

                        <span class="appointment-status">
                            <%= appointment.status %>
                        </span>

                    </div>

                    <h2><%= appointment.doctor.specialization %></h2>

                    <div class="appointment-info">

                        <p>
                            <i class="bi bi-calendar3"></i>
                            <span>Date:</span>
                            <%= appointment.appointmentDate.toLocaleDateString() %>
                        </p>

                        <p>
                            <i class="bi bi-clock"></i>
                            <span>Time:</span>
                            <%= appointment.appointmentTime %>
                        </p>

                        <% if(appointment.reason){ %>
                            <p>
                                <i class="bi bi-chat-left-text"></i>
                                <span>Reason:</span>
                                <%= appointment.reason %>
                            </p>
                        <% } %>

                    </div>

                    <% if(appointment.status !== "completed" && appointment.status !== "cancelled"){ %>

                        <div class="appointment-actions">

                            <a href="/appointment/<%= appointment._id %>/edit">
                                <i class="bi bi-pencil"></i>
                                Edit
                            </a>

                            <form action="/appointment/<%= appointment._id %>?_method=DELETE" method="post">

                                <button type="submit">
                                    <i class="bi bi-x-lg"></i>
                                    Cancel
                                </button>

                            </form>

                        </div>

                    <% } %>

                </div>

            <% } %>

        </div>

    <% } %>

</main>

</body>
</html>