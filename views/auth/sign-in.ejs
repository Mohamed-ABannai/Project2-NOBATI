<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In | NOBATI</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>

<body>

  <%- include('../partials/navbar') %>

    <main class="auth-container">

      <div class="auth-box">

        <div class="auth-form-section">

          <p class="auth-label">WELCOME BACK</p>
          <h1>Sign In</h1>
          <p class="auth-description">
            Sign in to your NOBATI account to continue.
          </p>

          <form action="/auth/sign-in" method="POST">

            <div class="auth-group">
              <label for="username">Username</label>
              <input type="text" name="username" id="username" placeholder="Enter your username" required>
            </div>

            <div class="auth-group">
              <label for="password">Password</label>
              <input type="password" name="password" id="password" placeholder="Enter your password" required>
            </div>

            <button class="auth-button" type="submit">
              Sign In
            </button>

          </form>

          <p class="auth-login">
            Don't have an account?
            <a href="/auth/sign-up">Create an account</a>
          </p>

        </div>

        <div class="auth-brand">

          <img src="../assests/NOBATI.png" alt="NOBATI">

          <h2>Your Health, Your Turn.</h2>

          <p>
            Find doctors and manage your clinic appointments easily.
          </p>

        </div>

      </div>

    </main>

</body>

</html>